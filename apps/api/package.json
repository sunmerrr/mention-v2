{
  "name": "@app/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API 서버 (NestJS 11 + Fastify + swc)",
  "main": "dist/src/main.js",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "dev": "nest start --watch --builder swc",
    "build": "nest build --builder swc",
    "start": "node dist/src/main.js",
    "lint": "biome check src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "clean": "rm -rf dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "DOTENV_CONFIG_PATH=../../.env tsx src/db/migrate.ts",
    "db:import-source": "DOTENV_CONFIG_PATH=../../.env tsx src/db/import-source.ts",
    "db:migrate:production": "node dist/src/db/migrate.js"
  },
  "dependencies": {
    "@app/shared": "workspace:*",
    "@aws-sdk/client-ssm": "^3.1014.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "10.1.10",
    "@nestjs/common": "11.2.9",
    "@nestjs/core": "11.2.9",
    "@nestjs/platform-fastify": "11.2.9",
    "@nestjs/schedule": "12.0.3",
    "@nestjs/swagger": "11.4.8",
    "@paralleldrive/cuid2": "3.3.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "5.6.0",
    "pg": "8.23.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.9",
    "@swc/cli": "0.8.2",
    "@swc/core": "^1.15.18",
    "@swc/helpers": "^0.5.19",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "^7.2.0",
    "drizzle-kit": "0.31.11",
    "supertest": "^7.2.2",
    "tsx": "^4.9.0",
    "typescript": "^5.4.0",
    "unplugin-swc": "2.0.0",
    "vitest": "4.1.12"
  }
}
