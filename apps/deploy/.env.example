# Copy to apps/deploy/.env; use the exact tested image in every environment.
MENTION_IMAGE=mention-web:COMMIT_SHA
MENTION_PORT=8790
MENTION_LISTEN_HOST=0.0.0.0
MENTION_RUNTIME_DIR=/app/runtime
MENTION_ENABLE_WRITES=0
# Replace with an explicitly configured compatible HTTP source in the container network.
MENTION_LEGACY_URL=http://127.0.0.1:8766
