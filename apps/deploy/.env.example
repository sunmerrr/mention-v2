# Copy to the private host-stack .env; never commit actual values.
ECR_REPOSITORY=example.invalid/mention
IMAGE_TAG_MENTION_SERVER=immutable-build-tag
MENTION_PUBLIC_HOST=mention.example.com
MENTION_COLLECTOR_HOST=collector.example.com
NODE_ENV=production
# Use the container IDs that map to the dedicated tunnel identity on the host.
# Rootless Docker maps the daemon user's host identity to container ID 0.
APP_UID=1000
APP_GID=1000
CONNECTION_SOCKET_DIRECTORY=/home/mention/.local/run/mention/connection
KAKAO_CONNECTION_SOCKET=/run/mention/connection/connection.sock
# Activate only after the old analytics consumer is drained.
# KAKAO_OBSERVATION_SOCKET=/run/mention/connection/observation.sock
# Intake remains OFF until source cursor/data handoff is verified.
KAKAO_EVENTS_ENABLED=0
# Enable on the worker only after the evidence snapshot and cursor are reconciled.
KAKAO_CONTEXT_ENABLED=0
# When no PostgreSQL checkpoint exists, an explicitly approved initial cursor is required.
# KAKAO_START_CURSOR=OWNER_INSTANCE:owner:SEQUENCE
POSTGRES_DB=mention
POSTGRES_USER=mention
POSTGRES_PASSWORD=REPLACE_WITH_PRIVATE_VALUE
DATABASE_URL=postgresql://mention:REPLACE_WITH_PRIVATE_VALUE@postgres:5432/mention
MONITORING_READ_BACKEND=postgres
MENTION_WEB_ROOT=/app/web
MENTION_WRITES_ENABLED=0
CORS_ORIGINS=https://mention.example.com
# Transitional projection import only; remove after native processing parity.
MENTION_SOURCE_URL=http://127.0.0.1:8790
MENTION_SOURCE_TIMEOUT_MS=20000
