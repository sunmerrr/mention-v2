# ─────────────────────────────────────────────────────────────
# .env.example — git에 커밋. 실제 값은 .env(gitignore)에.
# 어느 경로로 주입되든(Parameter Store / 컨테이너 env / .env) 코드는 config 모듈만 본다.
# → config/runtime-configuration.md "env 출처 폭포"
# ─────────────────────────────────────────────────────────────

# 공통 코어 (Part 1)
NODE_ENV=development
# APP_ROLE: 단일 이미지가 이 값으로 역할 분기 (api / worker / all)
APP_ROLE=all
PORT=4200
# LOG_LEVEL: fatal|error|warn|info|debug|trace. 비우지 말 것 — 빈 문자열은 enum 검증 실패.
# 미설정 시 앱 기본값(개발 debug / 운영 info)을 쓴다. 바꿀 때만 주석 해제.
# LOG_LEVEL=debug
# 콤마 구분 CORS 허용 origin (예: https://app.example.com,https://qa.example.com)
CORS_ORIGINS=http://localhost:5173

# ─── env 출처 폭포: Parameter Store (선택) ───
# PARAMETER_STORE_PATH가 설정된 경우에만 SSM에서 로드한다. 미설정이면 env/.env만 사용.
PARAMETER_STORE_PATH=
# 아래 둘은 optional — 없으면 IAM Role 자격증명을 사용한다.
PARAMETER_STORE_ACCESS_KEY=
PARAMETER_STORE_SECRET_KEY=
AWS_REGION=ap-northeast-2

# ─────────────────────────────────────────────────────────────
# 선택 블록(bootstrap Part 2)을 도입할 때 아래 주석을 해제해 추가한다.
# "쓰지 않는 블록은 만들지 않는다" — 지금은 코어에 없다.
# ─────────────────────────────────────────────────────────────
# DATABASE_URL=
# REDIS_HOST=
# REDIS_PORT=
# JWT_SECRET=
# S3_BUCKET=

# ─── 프론트 런타임 config (web 컨테이너 entrypoint가 index.html placeholder 치환) ───
API_URL=http://localhost:4200
SOCKET_URL=
