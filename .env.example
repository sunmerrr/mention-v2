# ─────────────────────────────────────────────────────────────
# .env.example — git에 커밋. 실제 값은 .env(gitignore)에.
# 어느 경로로 주입되든(Parameter Store / 컨테이너 env / .env) 코드는 config 모듈만 본다.
# → config/runtime-configuration.md "env 출처 폭포"
# ─────────────────────────────────────────────────────────────

# 공통 코어 (Part 1)
NODE_ENV=development
# APP_ROLE: 단일 이미지가 이 값으로 역할 분기 (api / worker / all)
APP_ROLE=all
PORT=4200
# LOG_LEVEL: fatal|error|warn|info|debug|trace. 비우지 말 것 — 빈 문자열은 enum 검증 실패.
# 미설정 시 앱 기본값(개발 debug / 운영 info)을 쓴다. 바꿀 때만 주석 해제.
# LOG_LEVEL=debug
# 콤마 구분 CORS 허용 origin (예: https://app.example.com,https://qa.example.com)
CORS_ORIGINS=http://localhost:5173

# ─── env 출처 폭포: Parameter Store (선택) ───
# PARAMETER_STORE_PATH가 설정된 경우에만 SSM에서 로드한다. 미설정이면 env/.env만 사용.
PARAMETER_STORE_PATH=
# 아래 둘은 optional — 없으면 IAM Role 자격증명을 사용한다.
PARAMETER_STORE_ACCESS_KEY=
PARAMETER_STORE_SECRET_KEY=
AWS_REGION=ap-northeast-2

# ─────────────────────────────────────────────────────────────
# 선택 블록(bootstrap Part 2)을 도입할 때 아래 주석을 해제해 추가한다.
# "쓰지 않는 블록은 만들지 않는다" — 지금은 코어에 없다.
# ─────────────────────────────────────────────────────────────
# DATABASE_URL=
# REDIS_HOST=
# REDIS_PORT=
# JWT_SECRET=
# S3_BUCKET=

# ─── 프론트 런타임 config (web 컨테이너 entrypoint가 index.html placeholder 치환) ───
API_URL=http://localhost:4200
SOCKET_URL=

# Read-only transitional source. This is not a new Kakao connection.
MENTION_SOURCE_URL=http://127.0.0.1:8790
MENTION_SOURCE_TIMEOUT_MS=20000

# Public projection and guarded migration preview. Supply private DB credentials locally.
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:15432/mention_internal
MONITORING_READ_BACKEND=postgres
MENTION_WRITES_ENABLED=0
# MENTION_WEB_ROOT=/app/web

# Prepared remote connection intake; never enable beside the current production workers.
KAKAO_CONNECTION_SOCKET=/run/mention/connection/connection.sock
# Activate only after the old analytics consumer is drained.
# KAKAO_OBSERVATION_SOCKET=/run/mention/connection/observation.sock
KAKAO_EVENTS_ENABLED=0
# Worker-side publication after the evidence snapshot and cursor are reconciled.
KAKAO_CONTEXT_ENABLED=0
# KAKAO_START_CURSOR=OWNER_INSTANCE:owner:SEQUENCE
# Same-host only. The owner and worker must see the same absolute directory.
# KAKAO_NATIVE_MEDIA_DIRECTORY=/absolute/path/to/state/monitor/photos/mention-native
WORKER_RUN_ONCE=0
