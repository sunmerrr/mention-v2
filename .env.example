# Optional overrides. No credentials belong in this application.
MENTION_PORT=8790
# Unset uses runtime/deployment.json; 0 disables, 1 enables monitoring edits.
# MENTION_ENABLE_WRITES=0
# HTTP compatibility mode only; deployed Unix-socket mode uses deployment.json.
MENTION_LEGACY_URL=http://127.0.0.1:8766
# Optional isolated web state directory (absolute path recommended).
# MENTION_RUNTIME_DIR=/absolute/path/to/runtime
# Container only; local lifecycle defaults to loopback.
# MENTION_LISTEN_HOST=127.0.0.1
# Optional release metadata (no environment-specific build values).
# MENTION_BUILD_ID=development
# Origin idle timeout; headers timeout is derived as this value + 10 seconds.
# HTTP_KEEP_ALIVE_TIMEOUT_MS=970000
